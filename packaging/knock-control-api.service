[Unit]
Description=Knock Control API for server-issued client profiles
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/knock-control/settings.json

[Service]
Type=simple
ExecStart=/usr/local/sbin/knock-control serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/etc/knock-control /var/lib/knock-control /run
StateDirectory=knock-control
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
