#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=11

start_service() {
    /usr/sbin/knock-control migrate || return 1
    /usr/sbin/knock-control configured >/dev/null || return 0
    procd_open_instance api
    procd_set_param command /usr/sbin/knock-control serve
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
