#!/bin/sh /etc/rc.common
USE_PROCD=1
START=96
STOP=10

start_service() {
    /usr/sbin/knock-control migrate || return 1
    /usr/sbin/knock-control configured >/dev/null || return 0
    /usr/sbin/knock-control activated >/dev/null || return 0
    /usr/sbin/knock-control generate-config || return 1
    /usr/sbin/knock-control firewall || return 1
    procd_open_instance daemon
    procd_set_param command /usr/sbin/knock-control-daemon -c /etc/knock-control/knockd.conf
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    /usr/sbin/knock-control apply || return 1
    /etc/init.d/knock-control-api restart
}

service_triggers() {
    procd_add_reload_trigger knock-control
}
